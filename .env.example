# Data source: auto|nse|yahoo|synthetic|fixture
NR_PROVIDER=auto

# Research loop
NR_MAX_ITERATIONS=3
NR_MAX_RELAXATIONS=2
NR_DTE_MIN=3
NR_DTE_MAX=14
NR_SIGMA_MULTIPLE=1.0
NR_WING_STEPS=2

# Risk guard rails
NR_MIN_POP=0.55
NR_MIN_CREDIT_RATIO=0.15
NR_MAX_LOSS_PER_LOT=150000
NR_MIN_LEG_OI=5000
NR_MIN_IV_RV_EDGE=-0.02
NR_ALLOW_UNDEFINED=true

# Modelling: expectation vol = rv_weight * realised + (1 - rv_weight) * implied
NR_RV_WEIGHT=0.5
NR_NAKED_MARGIN_PCT=0.15

# Instrument / outputs
NR_LOT_SIZE=75
NR_STRIKE_STEP=50
NR_RISK_FREE=0.065
NR_OUT_DIR=data/out
NR_LOG_PATH=data/research_log.jsonl
# NR_POSITIONS=positions.example.json

# Optional LLM hypothesis planner (any OpenAI-compatible endpoint)
NR_LLM_ENABLED=false
NR_LLM_BASE_URL=http://127.0.0.1:11434/v1
NR_LLM_MODEL=llama3.1
NR_LLM_TIMEOUT=30
